# このファイルをコピーして .env を作る(.env はコミットしない)
#   cp .env.example .env
# 値はローカル開発(docker-compose.yml)用。本番の値は Vercel の環境変数に設定する。

# PostgreSQL(docker-compose の postgres)
DATABASE_URL="postgresql://recipe:recipe@localhost:5434/recipe_share"

# Better Auth
# 秘密鍵は32文字以上のランダムな文字列にする。例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me-to-a-random-string-of-32-chars-or-more"
BETTER_AUTH_URL="http://localhost:3000"

# 写真の保存先(docker-compose の storage = RustFS。本番は Supabase Storage の S3 互換 API)
S3_ENDPOINT="http://localhost:9200"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="recipe-dev"
S3_SECRET_ACCESS_KEY="recipe-dev-secret"
S3_BUCKET="recipe-share-images"
